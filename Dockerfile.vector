FROM python:3.12-slim AS builder
WORKDIR /build
COPY pyproject.toml .
COPY src ./src
RUN pip wheel --no-cache-dir --wheel-dir /wheels '.[vector,embeddings,pdf]'

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels 'rag-document-intelligence[vector,embeddings,pdf]' \
    && rm -rf /wheels \
    && useradd --uid 10001 --create-home app
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn","rag_intelligence.vector_api:create_app","--factory","--host","0.0.0.0","--port","8000"]
